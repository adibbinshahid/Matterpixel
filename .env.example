# Matterpixel website — environment variables.
# Copy to .env.local for development and add the same keys in Vercel.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser;
# everything else is read in server code only (app/api/quote/route.ts).

# ── Quote form, step 1: Supabase (source of truth) ──────────────────────
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_…), Project Settings → API Keys. SERVER ONLY:
# bypasses row-level security. Create the table with docs/supabase-inbound.sql.
SUPABASE_SECRET_KEY=

# ── Quote form, step 2: backup email (Resend) ────────────────────────────
# Server only. Leave empty to skip the backup email (everything else still runs).
RESEND_API_KEY=
# Inbox that receives the plain-text copy of every quote.
LEAD_BACKUP_TO=adib@matterpixel.com
# Optional. Must be on matterpixel.com (verified in Resend).
# Defaults to "Matterpixel Website <noreply@matterpixel.com>".
LEAD_BACKUP_FROM=

# ── Quote form, step 3: n8n / PixelScout Telegram alert (server only) ────
# Optional. Both must be set, or the alert step is skipped silently.
# Never prefix these with NEXT_PUBLIC_: they must not reach the browser.
QUOTE_WEBHOOK_URL=
# Long random string. Sent as the x-pixelscout-secret header; check it in n8n.
QUOTE_WEBHOOK_SECRET=

# ── Public (sent to the browser) ─────────────────────────────────────────
# Cal.com event for the free audit call: username/event-slug.
NEXT_PUBLIC_CAL_LINK=matterpixel/audit
# WhatsApp number, digits only with country code (no +).
NEXT_PUBLIC_WHATSAPP=880XXXXXXXXXX
# Inbox for "Quick question" emails.
NEXT_PUBLIC_CONTACT_EMAIL=adib@matterpixel.com

# ── Cloudflare Turnstile — bot check on the quote form ───────────────────
# Leave both empty to switch it off. Hostnames: matterpixel.com,
# www.matterpixel.com, localhost.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Search Console HTML-tag verification (content="…" value only) ─
GOOGLE_SITE_VERIFICATION=
