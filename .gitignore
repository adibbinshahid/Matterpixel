# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Pre-optimization source assets, kept locally as a fallback if any
# re-encode ever needs redoing. ~10MB — deliberately untracked so it
# doesn't live in git history forever.
/public/videos/*.original.*
/public/WhoWeWorkFor/.orig/

# Raw asset sources. Hundreds of MB of untouched PNG/MP4 that Vercel would
# clone on every deploy — the optimized exports in /public/projects and
# /public/services are what ships.
/brand/projects-source/
/brand/services-source/

# AI agent tooling installed locally (impeccable skill copies, binaries,
# machine-specific hook settings) — not part of the site.
/.agent/
/.agents/
/.claude/
/.codex/
/.cursor/
/.gemini/
# Impeccable runtime state (the config, design.json and surfaces are kept).
/.impeccable/tmp/
/.impeccable/hook.cache.json
